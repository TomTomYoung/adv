{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "灯帰り 戦闘バフ",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "turns": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "stats": {
        "type": "object",
        "properties": {
          "str": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3
          },
          "vit": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3
          },
          "agi": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3
          },
          "int": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 3
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "resist": {
        "type": "object",
        "additionalProperties": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "required": [
      "id",
      "name",
      "turns",
      "stats",
      "resist"
    ],
    "additionalProperties": false

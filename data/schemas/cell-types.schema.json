{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {},
  "title": "セル種プリセット",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "type": "string",
    "minLength": 1,
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "minLength": 1
      },
      "description": {
        "type": "string",
        "minLength": 1
      },
      "passage": {
        "enum": [
          ".",
          "#"
        ],
        "description": "通行可否のみ。見た目・遮光・水密・イベントを意味しない。"
      },
      "visual": {
        "type": "object",
        "properties": {
          "wall": {
            "type": "boolean"
          },
          "floor": {
            "type": "boolean"
          },
          "opaque": {
            "type": "boolean"
          },
          "material": {
            "enum": [
              "floor",
              "wall"
            ]
          },
          "surface": {
            "enum": [
              "stone",
              "earth",
              "wood",
              "wet",
              "ice",
              "cracked",
              "salt",
              "roots",
              "thorns",
              "poison",
              "corrosion",
              "rune",
              "rock"
            ]
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "wall",
          "floor",
          "opaque",
          "material"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "properties": {
          "illumination": {
            "type": "integer",
            "minimum": 0,
            "maximum": 8
          },
          "water_passable": {
            "type": "boolean"
          },
          "floor_depth": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "bottomless": {
            "type": "boolean"
          },
          "water_level": {
            "type": "number",
            "minimum": -30,
            "maximum": 0
          },
          "water_depth": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "slippery": {
            "type": "boolean"
          },
          "fragile": {
            "type": "boolean"
          },
          "safe": {
            "type": "boolean"
          },
          "corrosion": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "binding": {
            "enum": [
              "compartment_water",
              "air_pocket",
              "corrosion",
              "vector_curse",
              "suppression_zone",
              "breakable_walls",
              "root_bridge",
              "thorn_wall"
            ]
          }
        },
        "propertyNames": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "additionalProperties": {
          "type": [
            "number",
            "string",
            "boolean"
          ]
        },
        "required": [
          "illumination",
          "water_passable"
        ]
      },
      "events": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "required": [
      "passage",
      "visual",
      "parameters",
      "events"
    ],
    "additionalProperties": false
  }
}

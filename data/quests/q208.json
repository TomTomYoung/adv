    "graph": [
      {
        "id": "entry",
        "text": "メアは小灯の横へ父親の名札を立てていた。「仕事の帰りに、読めるようにしたんです」。フユから届いたのは「消してください」という短い申し出だった。中継火そのものへの苦情ではない。",
        "options": [
          {
            "id": "ask",
            "text": "納骨所へ行き、フユに何を避けたいのか聞く",
            "to": "request",
            "action": "entry_ask"
          }
        ]
      },
      {
        "id": "request",
        "text": "フユは、父が同僚を助けたことを否定しなかった。「でも、家でされたことまで、それで良かったことにしないで」。灯の前で毎回頭を下げるよう求められるのがつらいという。「隠すか、消すか、札を返して。仲間だった話まで奪う気はない」",
        "options": [
          {
            "id": "take",
            "text": "本人が用意した覆いを預かり、三つの希望を世話役へ伝えに戻る",
            "to": "decide",
            "action": "request_take"
          }
        ]
      },
      {
        "id": "decide",
        "text": "メアに申し出を伝えると、彼女は小灯の位置を見た。「ここを通るたび、礼をしてもらっていた」。覚えていたい同僚と、娘が頭を下げる義務は、同じものではなかった。覆いで名を隠すには固定用の縄が要る。",
        "options": [
          {
            "id": "screen",
            "text": "縄1本で覆いを固定し、通路から名が見えないようにする",
            "to": "@screen",
            "action": "decide_screen"
          },
          {
            "id": "off",
            "text": "世話役の同意を得て私設の小灯を消し、札を伏せて預ける",
            "to": "@off",
            "action": "decide_off"
          },
          {
            "id": "private",
            "text": "名札を預かり、フユへ返しに行く",
            "to": "return",
            "action": "decide_private"
          }
        ]
      },
      {
        "id": "return",
        "text": "フユの前へ戻った。名札と覆いを持っている。灯を囲む仲間の記憶まで消す約束はしていないが、本人に参加を求める札は持ち帰れた。",
        "options": [
          {
            "id": "hand",
            "text": "名札と覆いを返し、公開の追悼から外したことを伝える",
            "to": "@private",
            "action": "return_hand"
          }
        ]
      }
    ],
    "conflict": {
      "request": "中継広間の小さな追悼灯を消してほしいという申し出が届いた。世話役は納骨所にいる申出人の意向を確かめてほしい。",
      "progression": "申出人の意向を聞き、名を隠す覆いを預かる。灯の防護効果を変えず、遮蔽、私設灯の消灯、名札の返却を選ぶ。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    },

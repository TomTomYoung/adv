    "hunt": {
      "label": "今季の討伐",
      "text": "今季の被害は止まった。ユノは来季の餌場も調べると、師の弓とは別に地図を持ち帰った。",
      "gold": 81,
      "xp": 63
    },
    "guide": {
      "label": "群れの通り道",
      "text": "群れは迂回路を抜けた。オサは現場を見届け、弓を捨てるのでなく、弟子へ渡す笛の穴を削った。",
      "gold": 81,
      "xp": 63
    },
    "guard": {
      "label": "柵の森番",

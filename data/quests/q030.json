                  },
                  "commands": [
                    {
                      "op": "set",
                      "target": "flags.dungeonNotes.region_3",
                      "value": true
                    },
                    {
                      "op": "narrate",
                      "text": "現地の観察を手帳に記した。"
                    }
                  ]
                },
                {
                  "id": "leave",
                  "text": "探索へ戻る",
                  "commands": []
                }
              ]
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "この植床には、渡れるまで育った根橋がない。種と培養土を使って根橋草を植え、成長を待ってから調べよう。"
            }
          ]
        }

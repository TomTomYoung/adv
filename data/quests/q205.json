                }
              ]
            },
            {
              "id": "preserve",
              "text": "焼く手順として使わず、昔の仕事の見本として師へ返す",
              "storyAction": {
                "quest": "q205",
                "action": "talk_preserve"
              },
              "requirement": "",
              "commands": [

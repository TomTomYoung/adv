    "q205.v11.recovered": {
      "storyQuest": "q205",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q205",
          "scene": "recovered"
        },
        {
          "op": "say",
          "text": "配合板を手元へ引き寄せた。裏には「今の木では崩れる」とダンの字で書かれていた。古い手順が正しいかどうかは、板を取り戻しただけでは決まらない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "return",
              "text": "配合板を持って作業台へ戻る",
              "storyAction": {
                "quest": "q205",
                "action": "recovered_return"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q205",
                  "action": "recovered_return"
                }
              ]
            }
          ]
        }
      ]
    },
    "q205.v11.talk": {
      "storyQuest": "q205",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q205",
          "scene": "talk"
        },
        {
          "op": "say",
          "text": "ダンは板の裏を見て、捨てたことを認めた。「同じように焼くな。俺がそれで失敗した」。ノノは板を裏返す。「なら、違うところを教えて」。ダンは、今の材料で試すなら自分の名を成功の保証に使わないことを条件にした。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "revise",
              "text": "失敗の注記を残し、ノノ自身の試験用として板を渡す",
              "storyAction": {
                "quest": "q205",
                "action": "talk_revise"
              },
              "requirement": "",

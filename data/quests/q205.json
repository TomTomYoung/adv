  "scripts": {
    "q205.v11.entry": {
      "storyQuest": "q205",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q205",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "ノノは配合板の輪郭を指で描いた。「あれを見ながらなら、同じように焼ける」。ダンは灰のついた袖を払う。「拾わなくていい」。どちらも、最後に板を触ったのが誰かとは言わなかった。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "go",
              "text": "灰溜まりへ行き、板と音の正体を確かめる",
              "storyAction": {
                "quest": "q205",
                "action": "entry_go"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q205",
                  "action": "entry_go"
                }
              ]
            }
          ]
        }
      ]
    },
    "q205.v11.ash": {
      "storyQuest": "q205",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q205",
          "scene": "ash"
        },
        {
          "op": "say",
          "text": "灰虫が巣材を掻き寄せている。その下に、角が焦げた配合板が見える。虫を退けて拾うか、縁から縄を掛けて引き上げられそうだ。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "fight",
              "text": "灰虫を退け、板を拾う",
              "storyAction": {
                "quest": "q205",
                "action": "ash_fight"
              },
              "requirement": "戦闘・作業と消費は勝利時に確定",
              "commands": [
                {
                  "op": "battle.start",
                  "encounter": "kagaribi_pests",
                  "on_win": [
                    {
                      "op": "story.action",
                      "quest": "q205",
                      "action": "ash_fight"
                    },
                    {
                      "op": "jump",
                      "script": "q205.v11.recovered"
                    }
                  ],
                  "on_escape": [
                    {
                      "op": "say",
                      "text": "退路へ戻った。この作業の移動・受け渡し・支払いはまだ確定していない。"
                    }
                  ],
                  "on_lose": [
                    {
                      "op": "say",
                      "text": "現場から救援された。依頼を再開すると、未完了の作業からやり直せる。"
                    }
                  ]
                }
              ]
            },
            {
              "id": "hook",
              "text": "縄1本を灰溜まりへ渡し、板を引き上げる",
              "storyAction": {
                "quest": "q205",
                "action": "ash_hook"
              },
              "requirement": "縄 1消費",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q205",
                  "action": "ash_hook"
                },
                {
                  "op": "jump",
                  "script": "q205.v11.recovered"
                }
              ]
            },
            {
              "id": "hook_supplies",
              "text": "補修用の縄1個を用意しに戻る",
              "condition": {
                "op": "not",
                "arg": {

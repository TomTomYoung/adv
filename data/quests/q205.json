        }
      }
    ],
    "graph": [
      {
        "id": "entry",
        "text": "ノノは配合板の輪郭を指で描いた。「あれを見ながらなら、同じように焼ける」。ダンは灰のついた袖を払う。「拾わなくていい」。どちらも、最後に板を触ったのが誰かとは言わなかった。",
        "options": [
          {
            "id": "go",
            "text": "灰溜まりへ行き、板と音の正体を確かめる",
            "to": "ash",
            "action": "entry_go"
          }
        ]
      },
      {
        "id": "ash",
        "text": "灰虫が巣材を掻き寄せている。その下に、角が焦げた配合板が見える。虫を退けて拾うか、縁から縄を掛けて引き上げられそうだ。",
        "options": [
          {
            "id": "fight",
            "text": "灰虫を退け、板を拾う",
            "to": "recovered",
            "combat": true,
            "action": "ash_fight"
          },
          {
            "id": "hook",
            "text": "縄1本を灰溜まりへ渡し、板を引き上げる",
            "to": "recovered",
            "action": "ash_hook"
          }
        ]
      },
      {
        "id": "recovered",
        "text": "配合板を手元へ引き寄せた。裏には「今の木では崩れる」とダンの字で書かれていた。古い手順が正しいかどうかは、板を取り戻しただけでは決まらない。",
        "options": [
          {
            "id": "return",
            "text": "配合板を持って作業台へ戻る",
            "to": "talk",
            "action": "recovered_return"
          }
        ]
      },
      {
        "id": "talk",
        "text": "ダンは板の裏を見て、捨てたことを認めた。「同じように焼くな。俺がそれで失敗した」。ノノは板を裏返す。「なら、違うところを教えて」。ダンは、今の材料で試すなら自分の名を成功の保証に使わないことを条件にした。",
        "options": [
          {
            "id": "revise",
            "text": "失敗の注記を残し、ノノ自身の試験用として板を渡す",
            "to": "@revise",
            "action": "talk_revise"
          },
          {
            "id": "preserve",
            "text": "焼く手順として使わず、昔の仕事の見本として師へ返す",
            "to": "@preserve",
            "action": "talk_preserve"
          },
          {
            "id": "stop",
            "text": "ノノに継承を断る意思を確かめ、板を保管場所へ戻す",
            "to": "@stop",
            "action": "talk_stop"
          }
        ]
      }
    ],
    "conflict": {
      "request": "炭焼き見習いが、灰を掻く音のする窯の奥へ落ちた配合板を取り戻したがっている。師匠は探すなと言う。",
      "progression": "灰虫を退けるか縄で縁から板を引き上げる。板を持って戻り、変えて継ぐ、見本として残す、焼き方の継承を断るという三つの判断をする。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    },

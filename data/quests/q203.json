  "outcomes": {
    "returned": {
      "gold": 57,
      "xp": 51,
      "label": "混入だけを確かめて返す",
      "text": "ゲルに試料瓶を返した。水の混入は確かめたが、燃焼品質は試していない。商人は瓶を振らずに台へ置いた。弁明のために持たせた瓶が、次に説明しなければならない事実になった。"
    },
    "limited": {
      "gold": 57,
      "xp": 51,
      "label": "使えた量を限って伝える",
      "text": "一目盛りの燃焼結果をゲルへ伝え、底の水が残る瓶を返した。取引全体のお墨付きにはしなかった。試験皿の油は検品係が保管し、残りの樽は別に検品する必要がある。"
    },
    "public": {
      "gold": 57,
      "xp": 51,
      "label": "残った水を審査へ預ける",
      "text": "水の残る瓶をユハへ渡し、納入名を添えた。燃えた一目盛りの結果も、不良の事実も記録に残る。水増しの故意を立証したわけではないが、ゲルには混入の経緯を公に説明する仕事が残った。"
    }
  },
  "scripts": {
    "q203.v11.entry": {
      "storyQuest": "q203",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q203",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "ゲルは封をした小瓶を両手で包んでいた。「水を売ったと言われたら、次はありません」。雨の日に漏斗をしまい忘れたことは認める。「燃えるかどうかは、自分の言葉だけで通したくない」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "carry",
              "text": "試料瓶を預かり、回廊の検品係へ運ぶ",
              "storyAction": {
                "quest": "q203",
                "action": "entry_carry"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q203",
                  "action": "entry_carry"
                }
              ]
            }
          ]
        }
      ]
    },
    "q203.v11.inspect": {
      "storyQuest": "q203",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q203",
          "scene": "inspect"
        },
        {
          "op": "say",
          "text": "ユハは瓶を台に置き、揺れがおさまるのを待った。底に透明な一目盛り、その上に油が二目盛りある。「分かれたね。燃える量は別に試す。試料だけで全樽に判を押すことはできない」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "return",
              "text": "燃焼試験をせず、分離した試料を商人へ返しに行く",
              "storyAction": {
                "quest": "q203",
                "action": "inspect_return"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q203",
                  "action": "inspect_return"
                }
              ]
            },
            {
              "id": "pour",
              "text": "上澄み二目盛りを試験皿へ分ける",
              "storyAction": {
                "quest": "q203",
                "action": "inspect_pour"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q203",
                  "action": "inspect_pour"
                },
                {
                  "op": "jump",
                  "script": "q203.v11.portion"
                }
              ]
            }
          ]
        }
      ]
    },
    "q203.v11.portion": {
      "storyQuest": "q203",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q203",
          "scene": "portion"
        },
        {
          "op": "say",
          "text": "試験皿に上澄み二目盛りを分けた。瓶には底の水が一目盛り残っている。ユハは一本の松明で、一目盛りだけを燃やす手順を示した。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "burn",
              "text": "松明1本を使い、一目盛りの燃焼を試す",
              "storyAction": {
                "quest": "q203",
                "action": "portion_burn"
              },
              "requirement": "松明 1消費",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q203",
                  "action": "portion_burn"
                },
                {
                  "op": "jump",
                  "script": "q203.v11.result"
                }
              ]
            },
            {
              "id": "burn_supplies",
              "text": "予備灯油1個を用意しに戻る",
              "condition": {
                "op": "not",
                "arg": {
                  "op": "has_item",
                  "item": "torch",
                  "count": 1
                }
              },
              "visibleWhen": {
                "op": "not",
                "arg": {
                  "op": "has_item",
                  "item": "torch",
                  "count": 1
                }
              },
              "commands": [
                {
                  "op": "jump",
                  "script": "q203.v11.portion.burn.shortage"
                }
              ]
            }
          ]
        }
      ]
    },
    "q203.v11.result": {
      "storyQuest": "q203",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q203",
          "scene": "result"
        },
        {
          "op": "say",
          "text": "上澄み一目盛りは燃えた。試験皿に油が一目盛り、瓶に水が一目盛り残る。「使える油もあった。それと納入が適正だったことは、同じじゃない」。ユハは、残った試料をどこへ渡すか尋ねた。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "limited",
              "text": "残った瓶を商人へ返し、今回の試験範囲だけ伝える",
              "storyAction": {
                "quest": "q203",
                "action": "result_limited"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",

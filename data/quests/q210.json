      ]
    },
    "q210.v11.box": {
      "storyQuest": "q210",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q210",
          "scene": "box"
        },
        {
          "op": "say",
          "text": "リトは箱の蓋を一度開けて見せた。「直したのは蝶番だけです」。スイは開閉する音を聞いた。夫の帰還を確かめる音ではないが、自分が持って帰れる物の音だった。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "take",
              "text": "スイ本人に修理した箱を受け取ってもらう",
              "storyAction": {
                "quest": "q210",
                "action": "box_take"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",

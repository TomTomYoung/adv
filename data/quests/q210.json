  "outcomes": {
    "letter": {
      "gold": 80,
      "xp": 360,
      "label": "手紙の帰る場所を作る",
      "text": "スイは手紙を箱へ納め、巡灯路まで戻った。箱の中身は故人への言葉で、蘇生の証明ではない。待ち続けることだけを、夫との関係の残し方にしなくてよくなった。",
      "gems": 24
    },
    "ritual": {
      "gold": 80,
      "xp": 360,
      "label": "今日の灯を自分で終える",
      "text": "普通の松明を灯して消したスイは、修理した箱を持って戻った。儀式が夫へ届いたとは確かめていない。それでも、今日の待ち時間を自分で終える行為は、本人が選んで済ませた。",
      "gems": 24
    },
    "hope": {
      "gold": 80,
      "xp": 360,
      "label": "信じる答えを保留して帰る",
      "text": "スイは伝承への望みを捨てると約束せず、箱と手紙を持って戻った。帰ることを、夫を見捨てた証拠にはしなかった。深火が死者を戻すかどうかは、依然として確かめられていない。",
      "gems": 24
    }
  },
  "scripts": {
    "q210.v11.entry": {
      "storyQuest": "q210",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q210",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "スイは夫への手紙を畳み直していた。「戻るとは、誰も確かめていないんでしょう。でも、私が帰ったあとだったら」。修理人が箱を直して待っていると伝えると、初めて背後の通路を見た。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "letter",
              "text": "手紙を修理した箱へ納めて持ち帰る提案をする",
              "storyAction": {
                "quest": "q210",
                "action": "entry_letter"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q210",
                  "action": "entry_letter"
                },
                {
                  "op": "jump",
                  "script": "q210.v11.ready"
                }
              ]
            },
            {
              "id": "ritual",
              "text": "蘇生の試みとは分け、普通の灯で待つ時間に区切りをつける",
              "storyAction": {
                "quest": "q210",
                "action": "entry_ritual"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q210",
                  "action": "entry_ritual"
                },
                {
                  "op": "jump",
                  "script": "q210.v11.ritual"
                }
              ]
            },
            {
              "id": "hope",
              "text": "伝承を信じるかは決めず、今日は帰ってよいと伝える",
              "storyAction": {
                "quest": "q210",
                "action": "entry_hope"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q210",
                  "action": "entry_hope"
                },
                {
                  "op": "jump",
                  "script": "q210.v11.ready"
                }
              ]
            }
          ]
        }
      ]
    },
    "q210.v11.ritual": {
      "storyQuest": "q210",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q210",
          "scene": "ritual"
        },
        {
          "op": "say",
          "text": "スイは「戻ってくる合図にしないなら」とうなずいた。使うのは探索隊の普通の松明で、祭壇の深火は移さない。火を見てから消すまでを、今日の待ち時間の終わりにする。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "light",
              "text": "松明1本を使って短く灯し、消してから帰り支度をする",
              "storyAction": {
                "quest": "q210",
                "action": "ritual_light"
              },
              "requirement": "松明 1消費",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q210",
                  "action": "ritual_light"
                },
                {
                  "op": "jump",
                  "script": "q210.v11.ready"
                }
              ]
            },
            {
              "id": "light_supplies",
              "text": "予備灯油1個を用意しに戻る",
              "condition": {
                "op": "not",
                "arg": {
                  "op": "has_item",
                  "item": "torch",
                  "count": 1
                }
              },
              "visibleWhen": {
                "op": "not",
                "arg": {
                  "op": "has_item",
                  "item": "torch",
                  "count": 1
                }
              },
              "commands": [
                {
                  "op": "jump",
                  "script": "q210.v11.ritual.light.shortage"
                }
              ]
            }
          ]
        }
      ]
    },
    "q210.v11.ready": {
      "storyQuest": "q210",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q210",
          "scene": "ready"
        },
        {
          "op": "say",
          "text": "スイは手紙を懐へ入れた。「箱を取りに行きます」。それは夫のことを忘れる約束ではなく、いま歩き出す返事だった。修理人は最後の巡回路の道具台にいる。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "walk",
              "text": "スイと祭壇を離れ、修理人の道具台へ歩く",
              "storyAction": {
                "quest": "q210",
                "action": "ready_walk"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",

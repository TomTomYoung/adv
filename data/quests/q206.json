                }
              ]
            }
          ]
        }
      ]
    },
    "q206.v11.returned": {
      "storyQuest": "q206",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q206",
          "scene": "returned"
        },
        {
          "op": "say",
          "text": "弁当を持ち帰ると、ミナは包みの重さを受け止めるように手を出した。ナギの退職理由を説明する約束はしていない。「受け取らなかった。それだけは、分かった」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "hand",

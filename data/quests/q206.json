    "graph": [
      {
        "id": "entry",
        "text": "ミナは包みの結び目を一つ緩めた。「手袋でも開けられるように」。弟がまだ勤務中だと思っている。「返事まで頼むつもりはありません。食べられるなら渡してください」",
        "options": [
          {
            "id": "carry",
            "text": "弁当を預かり、中継広間のナギへ届ける",
            "to": "offer",
            "action": "entry_carry"
          }
        ]
      },
      {
        "id": "offer",
        "text": "ナギは包みに触れなかった。「辞めたんです。もらったら、明日も行くってことになる」。当番の引継ぎは済ませたという。帰れないのは道が塞がれたからではなかった。",
        "options": [
          {
            "id": "gift",
            "text": "姉は勤務継続を条件にしていなかったと、受け取った言葉を伝える",
            "to": "gift",
            "action": "offer_gift"
          },
          {
            "id": "together",
            "text": "弁当を持ったまま、ナギが自分で話せるよう一緒に入口へ戻る",
            "to": "home",
            "action": "offer_together"
          },
          {
            "id": "return",
            "text": "受取りを断ったことだけを伝えると約束し、弁当を返しに行く",
            "to": "returned",
            "action": "offer_return"
          }
        ]
      },
      {
        "id": "gift",
        "text": "「続けろとは言ってなかった？」。ミナが実際に言った頼みを伝えると、ナギは結び目の緩んだところへ指を掛けた。「なら、食べたい。辞めた話は、自分でします」",
        "options": [
          {
            "id": "hand",
            "text": "仕事の約束にせず、受取りに同意したナギへ弁当を渡す",
            "to": "@gift",
            "action": "gift_hand"
          }
        ]
      },
      {
        "id": "home",
        "text": "二人でミナの前へ戻った。包みはまだ探索隊が持っている。ナギが先に口を開いた。「明日は、行かない」。ミナは結び目を見てから、弟の顔を見た。「じゃあ、今日はここで食べれば」",
        "options": [
          {
            "id": "hand",
            "text": "退職を伝えた本人へ、姉の前で弁当を渡す",
            "to": "@together",
            "action": "home_hand"
          }
        ]
      },
      {
        "id": "returned",
        "text": "弁当を持ち帰ると、ミナは包みの重さを受け止めるように手を出した。ナギの退職理由を説明する約束はしていない。「受け取らなかった。それだけは、分かった」",
        "options": [
          {
            "id": "hand",
            "text": "受取りを断られたことを伝え、弁当をミナへ返す",
            "to": "@returned",
            "action": "returned_hand"
          }
        ]
      }
    ],
    "conflict": {
      "request": "ミナが弟のナギへ弁当を届けたがっている。弟は勤務を終えたはずなのに、中継広間から上がってこない。",
      "progression": "弁当を預かって弟へ届ける。受け取る意味を確かめ、贈り物として渡す、本人と一緒に戻る、断られたまま返すという異なる帰結を扱う。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    }
  },

  "outcomes": {
    "gift": {
      "gold": 57,
      "xp": 51,
      "label": "差し入れを仕事の約束にしない",
      "text": "弁当はナギの手へ渡った。退職を姉へ伝える役目は本人に残した。「食べたい」と言えたことと、明日も働くことを同じ返事にしなかった。"
    },
    "together": {
      "gold": 57,
      "xp": 51,
      "label": "食べる場所を一緒に戻す",
      "text": "ナギは自分で退職を伝え、入口で弁当を受け取った。ミナが仕事探しまで引き受けたわけではない。それでも、明日の勤務の話をしなくても、一緒に食べる場所は残った。"
    },
    "returned": {
      "gold": 57,
      "xp": 51,
      "label": "拒まれたという返事を持ち帰る",
      "text": "弁当はミナへ戻った。弟の代わりに事情を告白せず、受取りを断ったという返事だけを伝えた。姉の心配は解けていない。ナギにも、黙ったままで済んだという保証は与えなかった。"
    }
  },
  "scripts": {
    "q206.v11.entry": {
      "storyQuest": "q206",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q206",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "ミナは包みの結び目を一つ緩めた。「手袋でも開けられるように」。弟がまだ勤務中だと思っている。「返事まで頼むつもりはありません。食べられるなら渡してください」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "carry",
              "text": "弁当を預かり、中継広間のナギへ届ける",
              "storyAction": {
                "quest": "q206",
                "action": "entry_carry"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q206",
                  "action": "entry_carry"
                }
              ]
            }
          ]
        }
      ]
    },
    "q206.v11.offer": {
      "storyQuest": "q206",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q206",
          "scene": "offer"
        },
        {
          "op": "say",
          "text": "ナギは包みに触れなかった。「辞めたんです。もらったら、明日も行くってことになる」。当番の引継ぎは済ませたという。帰れないのは道が塞がれたからではなかった。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "gift",
              "text": "姉は勤務継続を条件にしていなかったと、受け取った言葉を伝える",
              "storyAction": {
                "quest": "q206",
                "action": "offer_gift"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q206",
                  "action": "offer_gift"
                },
                {
                  "op": "jump",
                  "script": "q206.v11.gift"
                }
              ]
            },
            {
              "id": "together",
              "text": "弁当を持ったまま、ナギが自分で話せるよう一緒に入口へ戻る",
              "storyAction": {
                "quest": "q206",
                "action": "offer_together"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q206",
                  "action": "offer_together"
                }
              ]
            },
            {
              "id": "return",
              "text": "受取りを断ったことだけを伝えると約束し、弁当を返しに行く",
              "storyAction": {
                "quest": "q206",
                "action": "offer_return"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q206",
                  "action": "offer_return"
                }
              ]
            }
          ]
        }
      ]
    },
    "q206.v11.gift": {
      "storyQuest": "q206",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q206",
          "scene": "gift"
        },
        {
          "op": "say",
          "text": "「続けろとは言ってなかった？」。ミナが実際に言った頼みを伝えると、ナギは結び目の緩んだところへ指を掛けた。「なら、食べたい。辞めた話は、自分でします」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "hand",
              "text": "仕事の約束にせず、受取りに同意したナギへ弁当を渡す",
              "storyAction": {
                "quest": "q206",
                "action": "gift_hand"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q206",
                  "action": "gift_hand"
                },
                {
                  "op": "jump",
                  "script": "q206.v11.end.gift"
                }
              ]
            }
          ]
        }
      ]
    },
    "q206.v11.home": {
      "storyQuest": "q206",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q206",
          "scene": "home"
        },
        {
          "op": "say",
          "text": "二人でミナの前へ戻った。包みはまだ探索隊が持っている。ナギが先に口を開いた。「明日は、行かない」。ミナは結び目を見てから、弟の顔を見た。「じゃあ、今日はここで食べれば」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "hand",
              "text": "退職を伝えた本人へ、姉の前で弁当を渡す",
              "storyAction": {
                "quest": "q206",
                "action": "home_hand"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",

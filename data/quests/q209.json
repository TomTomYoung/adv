    "graph": [
      {
        "id": "entry",
        "text": "エルは盾の傷を指して「この一撃で倒したんですよね」と言った。ゼドは盾を裏返した。「倒したところは、見せられない」。誰の盾かを尋ねると、借り物だと認めた。「前は、これで構えて逃がした。それだけだ」",
        "options": [
          {
            "id": "battle",
            "text": "過去の噂は訂正した上で、今回の魔物との戦闘に立ち会う",
            "to": "challenge",
            "action": "entry_battle"
          },
          {
            "id": "escort",
            "text": "討伐の実演をせず、二人と安全確認をしながら巡灯路へ戻る",
            "to": "home",
            "action": "entry_escort"
          },
          {
            "id": "limited",
            "text": "教習への立会いを断り、過去の討伐は確認できないと報告へ記す",
            "to": "@limited",
            "action": "entry_limited"
          }
        ]
      },
      {
        "id": "challenge",
        "text": "近くをうろつく灰蝋の魔物に探索隊が対処し、ゼドとエルは退路側から手順を見ることになった。「今日倒せたとしても、前に倒した証拠にはならない」とゼドが言う。勝利するまで実演成功とは記せない。",
        "options": [
          {
            "id": "fight",
            "text": "探索隊が魔物を退け、二人に今回の戦闘を見届けてもらう",
            "to": "witness",
            "combat": true,
            "action": "challenge_fight"
          }
        ]
      },
      {
        "id": "witness",
        "text": "今回の魔物を退けた。エルは、探索隊が戦い、ゼドが退路側に立っていたと分けて記した。見ていない過去を埋めるための戦績ではない。",
        "options": [
          {
            "id": "sign",
            "text": "今回の探索隊の戦闘とゼドの見届けを、別々に報告へ記す",
            "to": "@battle",
            "action": "witness_sign"
          }
        ]
      },
      {
        "id": "home",
        "text": "ゼドとエルを伴って巡灯路へ戻った。途中の戦いがあれば探索隊の戦績であり、過去の噂とは別だ。ゼドは曲がり角で立つ位置を教え、エルは「倒すところ」ではなく「戻るところ」の欄を作った。",
        "options": [
          {
            "id": "record",
            "text": "歩いて帰った教習を記録し、討伐の噂も本人の言葉で訂正する",
            "to": "@escort",
            "action": "home_record"
          }
        ]
      }
    ],
    "conflict": {
      "request": "護衛見習いが、灰蝋の魔物を倒したという傭兵の実地教習に立ち会ってほしいと頼んできた。",
      "progression": "見習いの前で護衛と討伐を区別する。今回の戦闘を実演するか、戦わず帰路を教えるか、立会いを断って確認範囲だけ記す。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    }
  },

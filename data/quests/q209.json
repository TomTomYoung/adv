  "outcomes": {
    "battle": {
      "gold": 80,
      "xp": 340,
      "label": "今日見た戦いだけを書く",
      "text": "エルの報告には、今回戦った探索隊と見届けた二人の役割が残った。ゼドの過去の討伐は証明されていない。盾の傷を武勇に数えず、それでも次の仕事を頼むかは見習い自身に残した。",
      "gems": 30
    },
    "escort": {
      "gold": 50,
      "xp": 340,
      "label": "帰す仕事を教習にする",
      "text": "ゼドは、昔も倒さずに帰したのだとエルへ話した。二人は実際に巡灯路へ戻り、今回の帰路を記録した。噂の武勇は減ったが、帰還護衛として何を教えられるかは見える形になった。",
      "gems": 22
    },
    "limited": {
      "gold": 40,
      "xp": 340,
      "label": "確認していない武勇には署名しない",
      "text": "エルの報告には、過去の討伐を確認できず、今回の実演にも立ち会っていないと記された。ゼドを試すための戦いは起こさなかった。二人の関係の結論まで、探索隊が代わりに決めることもしなかった。",
      "gems": 12
    }
  },
  "scripts": {
    "q209.v11.entry": {
      "storyQuest": "q209",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q209",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "エルは盾の傷を指して「この一撃で倒したんですよね」と言った。ゼドは盾を裏返した。「倒したところは、見せられない」。誰の盾かを尋ねると、借り物だと認めた。「前は、これで構えて逃がした。それだけだ」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "battle",
              "text": "過去の噂は訂正した上で、今回の魔物との戦闘に立ち会う",
              "storyAction": {
                "quest": "q209",
                "action": "entry_battle"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q209",
                  "action": "entry_battle"
                },
                {
                  "op": "jump",
                  "script": "q209.v11.challenge"
                }
              ]
            },
            {
              "id": "escort",
              "text": "討伐の実演をせず、二人と安全確認をしながら巡灯路へ戻る",
              "storyAction": {
                "quest": "q209",
                "action": "entry_escort"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q209",
                  "action": "entry_escort"
                }
              ]
            },
            {
              "id": "limited",
              "text": "教習への立会いを断り、過去の討伐は確認できないと報告へ記す",
              "storyAction": {
                "quest": "q209",
                "action": "entry_limited"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q209",
                  "action": "entry_limited"
                },
                {
                  "op": "jump",
                  "script": "q209.v11.end.limited"
                }
              ]
            }
          ]
        }
      ]
    },
    "q209.v11.challenge": {
      "storyQuest": "q209",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q209",
          "scene": "challenge"
        },
        {
          "op": "say",
          "text": "近くをうろつく灰蝋の魔物に探索隊が対処し、ゼドとエルは退路側から手順を見ることになった。「今日倒せたとしても、前に倒した証拠にはならない」とゼドが言う。勝利するまで実演成功とは記せない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "fight",
              "text": "探索隊が魔物を退け、二人に今回の戦闘を見届けてもらう",
              "storyAction": {
                "quest": "q209",
                "action": "challenge_fight"
              },
              "requirement": "戦闘・作業と消費は勝利時に確定",
              "commands": [
                {
                  "op": "battle.start",
                  "encounter": "kagaribi_wax",
                  "on_win": [
                    {
                      "op": "story.action",
                      "quest": "q209",
                      "action": "challenge_fight"
                    },
                    {
                      "op": "jump",
                      "script": "q209.v11.witness"
                    }
                  ],
                  "on_escape": [
                    {
                      "op": "say",
                      "text": "退路へ戻った。この作業の移動・受け渡し・支払いはまだ確定していない。"
                    }
                  ],
                  "on_lose": [
                    {
                      "op": "say",
                      "text": "現場から救援された。依頼を再開すると、未完了の作業からやり直せる。"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "q209.v11.witness": {
      "storyQuest": "q209",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q209",
          "scene": "witness"
        },
        {
          "op": "say",
          "text": "今回の魔物を退けた。エルは、探索隊が戦い、ゼドが退路側に立っていたと分けて記した。見ていない過去を埋めるための戦績ではない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "sign",
              "text": "今回の探索隊の戦闘とゼドの見届けを、別々に報告へ記す",
              "storyAction": {
                "quest": "q209",
                "action": "witness_sign"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",

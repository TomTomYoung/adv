  "scripts": {
    "q204.v11.entry": {
      "storyQuest": "q204",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q204",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "エインは削り刀を帳面の脇へ置いた。「この名の人が荷を運んでいるそうです。間違いなら、消さないと」。追悼欄の元になった紙には「未帰還」とあり、死亡を確かめた者の名はない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "visit",
              "text": "欄の写しを持ち、交差路の本人を訪ねる",
              "storyAction": {
                "quest": "q204",
                "action": "entry_visit"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q204",
                  "action": "entry_visit"
                }
              ]
            }
          ]
        }
      ]
    },
    "q204.v11.meeting": {
      "storyQuest": "q204",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q204",
          "scene": "meeting"
        },
        {
          "op": "say",
          "text": "写しを見たリュカは、自分の名を指した。「生きてる。でも、居場所は書かないで」。事故の後、暴力を振るう家族のもとへ戻らず、別の仕事を始めたという。「名前を直すのと、迎えを呼ぶのは、同じじゃないよね」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "named",
              "text": "所在は載せず、生存した名だけ追記する同意と署名をもらう",
              "storyAction": {
                "quest": "q204",
                "action": "meeting_named"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q204",
                  "action": "meeting_named"
                },
                {
                  "op": "jump",
                  "script": "q204.v11.report"
                }
              ]
            },
            {
              "id": "sealed",
              "text": "氏名入り証言を封じ、閲覧を担当書記に限る条件で預かる",
              "storyAction": {
                "quest": "q204",
                "action": "meeting_sealed"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q204",
                  "action": "meeting_sealed"
                },
                {
                  "op": "jump",
                  "script": "q204.v11.report"
                }
              ]
            },
            {
              "id": "pending",
              "text": "署名は求めず、元の報告が未帰還だった点だけ訂正しに戻る",
              "storyAction": {
                "quest": "q204",
                "action": "meeting_pending"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q204",
                  "action": "meeting_pending"
                }
              ]
            }
          ]
        }
      ]
    },
    "q204.v11.report": {
      "storyQuest": "q204",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q204",
          "scene": "report"
        },
        {
          "op": "say",
          "text": "リュカは自分で署名し、証言を渡した。働いている区画は本文に書かない。「帳面を直したら、私はここで仕事を続ける。それまで約束してとは言わない」。未来の安全を保証したことにはしない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "carry",
              "text": "証言と写しを納骨所へ運ぶ",
              "storyAction": {
                "quest": "q204",
                "action": "report_carry"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q204",
                  "action": "report_carry"
                }
              ]
            }
          ]
        }
      ]
    },
    "q204.v11.filing": {
      "storyQuest": "q204",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q204",
          "scene": "filing"
        },
        {
          "op": "say",
          "text": "エインの前に戻った。削り刀はまだ机の上にある。元の未帰還報告を残し、何が後から確かめられたかを追記する方法を説明できる。本人の所在を知らせる必要はない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "add",
              "text": "公開に同意した名と生存確認を追記し、元の記録を残す",
              "storyAction": {
                "quest": "q204",
                "action": "filing_add"
              },
              "condition": {
                "op": "eq",
                "left": {
                  "ref": "stories.q204.values.consent"
                },
                "right": "named"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q204",
                  "action": "filing_add"
                },
                {
                  "op": "jump",
                  "script": "q204.v11.end.addendum"
                }
              ]
            },
            {
              "id": "seal",
              "text": "証言を封緘保管し、公開欄を「死亡未確認」へ訂正する",
              "storyAction": {
                "quest": "q204",
                "action": "filing_seal"
              },
              "condition": {
                "op": "eq",
                "left": {
                  "ref": "stories.q204.values.consent"

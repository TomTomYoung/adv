  "outcomes": {
    "addendum": {
      "gold": 57,
      "xp": 51,
      "label": "消さずに、生きている名を足す",
      "text": "エインは古い欄を削らず、本人の同意を得た生存確認を追記した。所在は載せなかった。帰還を数え落とした履歴も、いま生きている名も、同じ帳面に残った。"
    },
    "sealed": {
      "gold": 57,
      "xp": 51,
      "label": "公開する訂正と封じる証言を分ける",
      "text": "証言は担当書記だけが開ける封に収められ、公開欄は死亡未確認へ訂正された。生存確認を誰もが読める形にはしなかった。書記には、封を守り、必要な訂正を続ける責任が残る。"
    },
    "pending": {
      "gold": 57,
      "xp": 51,
      "label": "分からないことを死亡にしない",
      "text": "追悼欄には、元の報告が未帰還であり、死亡確認をしていないと追記された。リュカの生存証言を提出したことにはしなかった。削り刀を使わずに、帳面が断定しすぎた部分を直した。"
    }

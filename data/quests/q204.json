    "graph": [
      {
        "id": "entry",
        "text": "エインは削り刀を帳面の脇へ置いた。「この名の人が荷を運んでいるそうです。間違いなら、消さないと」。追悼欄の元になった紙には「未帰還」とあり、死亡を確かめた者の名はない。",
        "options": [
          {
            "id": "visit",
            "text": "欄の写しを持ち、交差路の本人を訪ねる",
            "to": "meeting",
            "action": "entry_visit"
          }
        ]
      },
      {
        "id": "meeting",
        "text": "写しを見たリュカは、自分の名を指した。「生きてる。でも、居場所は書かないで」。事故の後、暴力を振るう家族のもとへ戻らず、別の仕事を始めたという。「名前を直すのと、迎えを呼ぶのは、同じじゃないよね」",
        "options": [
          {
            "id": "named",
            "text": "所在は載せず、生存した名だけ追記する同意と署名をもらう",
            "to": "report",
            "action": "meeting_named"
          },
          {
            "id": "sealed",
            "text": "氏名入り証言を封じ、閲覧を担当書記に限る条件で預かる",
            "to": "report",
            "action": "meeting_sealed"
          },
          {
            "id": "pending",
            "text": "署名は求めず、元の報告が未帰還だった点だけ訂正しに戻る",
            "to": "pending",
            "action": "meeting_pending"
          }
        ]
      },
      {
        "id": "report",
        "text": "リュカは自分で署名し、証言を渡した。働いている区画は本文に書かない。「帳面を直したら、私はここで仕事を続ける。それまで約束してとは言わない」。未来の安全を保証したことにはしない。",
        "options": [
          {
            "id": "carry",
            "text": "証言と写しを納骨所へ運ぶ",
            "to": "filing",
            "action": "report_carry"
          }
        ]
      },
      {
        "id": "filing",
        "text": "エインの前に戻った。削り刀はまだ机の上にある。元の未帰還報告を残し、何が後から確かめられたかを追記する方法を説明できる。本人の所在を知らせる必要はない。",
        "options": [
          {
            "id": "add",
            "text": "公開に同意した名と生存確認を追記し、元の記録を残す",
            "to": "@addendum",
            "when": {
              "op": "eq",
              "left": {
                "ref": "stories.q204.values.consent"
              },
              "right": "named"
            },
            "action": "filing_add"
          },
          {
            "id": "seal",
            "text": "証言を封緘保管し、公開欄を「死亡未確認」へ訂正する",
            "to": "@sealed",
            "when": {
              "op": "eq",
              "left": {
                "ref": "stories.q204.values.consent"
              },
              "right": "sealed"
            },
            "action": "filing_seal"
          }
        ]
      },
      {
        "id": "pending",
        "text": "署名を求めず、写しを持って戻った。元の報告に死亡確認がないことは、この机の書類だけでも確かめられる。本人の事情を公簿の材料にする同意は取っていない。",
        "options": [
          {
            "id": "correct",
            "text": "本人の事情を伏せ、未帰還と死亡確認を分けて記す",
            "to": "@pending",
            "action": "pending_correct"
          }
        ]
      }
    ],
    "conflict": {
      "request": "納骨所の追悼欄にある名を、交差路で働く人が名乗っている。書記は名前を削る前に本人を訪ねてほしいという。",
      "progression": "追悼欄の写しを本人へ見せ、所在を伏せる条件を聞く。公開名の追記、封緘証言、未確認への訂正を選び、納骨所へ持ち帰る。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    }
  },

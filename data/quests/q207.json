    "graph": [
      {
        "id": "entry",
        "text": "オセは測り竿の端を自分の足に押しつけていた。「場所が悪かっただけだ」。ハルは基準石を指す。「まず、ここで同じ長さになるか」。二人の紙は、通路が狭いかどうかより先に食い違っている。",
        "options": [
          {
            "id": "check",
            "text": "基準石で、一人持ちと二人持ちを比べる",
            "to": "calibrated",
            "action": "entry_check"
          },
          {
            "id": "unverified",
            "text": "追加測定を引き受けず、食い違いを未確認として記す",
            "to": "@unverified",
            "action": "entry_unverified"
          }
        ]
      },
      {
        "id": "calibrated",
        "text": "オセ一人では竿の先が揺れた。ハルが支えると基準石の目盛りに合った。「数字は、手の持ち主まで書くのか」とオセが言う。「一人で測った数字にするなら」とハルは答えた。",
        "options": [
          {
            "id": "go",
            "text": "二人と測り竿を伴い、実際の測点へ行く",
            "to": "measure",
            "action": "calibrated_go"
          }
        ]
      },
      {
        "id": "measure",
        "text": "測点へ着いた。ハルが竿の先端を支え、オセが目盛りを読む準備をする。前の紙はオセの手元にある。二人の関与を隠したまま、新しい数値だけ得ることは引き受けない。",
        "options": [
          {
            "id": "read",
            "text": "二人の作業で通路幅を測り直す",
            "to": "result",
            "action": "measure_read"
          }
        ]
      },
      {
        "id": "result",
        "text": "測り直した値はハルの旧値と一致した。オセの紙の狭い値は採用できない。「図面には二人の名を出すか、俺の前の値を引っ込めるかだな」。ハルは新しい値の脇に署名する場所を空けた。",
        "options": [
          {
            "id": "joint",
            "text": "二人の名で測量票を訂正し、ハルへ控えを渡す",
            "to": "@joint",
            "action": "result_joint"
          },
          {
            "id": "withdraw",
            "text": "旧値の撤回だけを記し、新図面の提出は保留する",
            "to": "@withdrawn",
            "action": "result_withdraw"
          }
        ]
      }
    ],
    "conflict": {
      "request": "最後の巡回路の幅が、二人の測量で食い違った。測量師は前の数値を確かめる同行者を求めている。",
      "progression": "基準石で測り方を検証し、二人を測点へ伴う。再測定の共同署名、旧値の撤回、再測定をしない未確認返却を選ぶ。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    }
  },

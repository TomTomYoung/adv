  "scripts": {
    "q207.v11.entry": {
      "storyQuest": "q207",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q207",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "オセは測り竿の端を自分の足に押しつけていた。「場所が悪かっただけだ」。ハルは基準石を指す。「まず、ここで同じ長さになるか」。二人の紙は、通路が狭いかどうかより先に食い違っている。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "check",
              "text": "基準石で、一人持ちと二人持ちを比べる",
              "storyAction": {
                "quest": "q207",
                "action": "entry_check"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q207",
                  "action": "entry_check"
                },
                {
                  "op": "jump",
                  "script": "q207.v11.calibrated"
                }
              ]
            },
            {
              "id": "unverified",
              "text": "追加測定を引き受けず、食い違いを未確認として記す",
              "storyAction": {
                "quest": "q207",
                "action": "entry_unverified"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q207",
                  "action": "entry_unverified"
                },
                {
                  "op": "jump",
                  "script": "q207.v11.end.unverified"
                }
              ]
            }
          ]
        }
      ]
    },
    "q207.v11.calibrated": {
      "storyQuest": "q207",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q207",
          "scene": "calibrated"
        },
        {
          "op": "say",
          "text": "オセ一人では竿の先が揺れた。ハルが支えると基準石の目盛りに合った。「数字は、手の持ち主まで書くのか」とオセが言う。「一人で測った数字にするなら」とハルは答えた。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "go",
              "text": "二人と測り竿を伴い、実際の測点へ行く",
              "storyAction": {
                "quest": "q207",
                "action": "calibrated_go"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q207",
                  "action": "calibrated_go"
                }
              ]
            }
          ]
        }
      ]
    },
    "q207.v11.measure": {
      "storyQuest": "q207",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q207",
          "scene": "measure"
        },
        {
          "op": "say",
          "text": "測点へ着いた。ハルが竿の先端を支え、オセが目盛りを読む準備をする。前の紙はオセの手元にある。二人の関与を隠したまま、新しい数値だけ得ることは引き受けない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "read",
              "text": "二人の作業で通路幅を測り直す",
              "storyAction": {
                "quest": "q207",
                "action": "measure_read"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.action",
                  "quest": "q207",
                  "action": "measure_read"
                },
                {
                  "op": "jump",
                  "script": "q207.v11.result"
                }
              ]
            }
          ]
        }
      ]
    },

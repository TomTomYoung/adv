    "graph": [
      {
        "id": "entry",
        "text": "ナヴィアは帳面の一行だけに乾いた布を当てていた。「数字は合っています。休み印だけ、確かめてきてください」。交差路で待つエンには、まだ給金を渡していない。",
        "options": [
          {
            "id": "ask",
            "text": "交差路へ行き、エン本人から話を聞く",
            "to": "witness",
            "action": "entry_ask"
          }
        ]
      },
      {
        "id": "witness",
        "text": "エンは指に巻いた布をほどいた。「休めと言ったのは向こうです。怠けたことにするなら、せめて自分でそう書いてくれ」。彼は休憩時刻と理由を書いた紙を差し出す。「渡していい。ただ、俺の署名を勝手に足すな」",
        "options": [
          {
            "id": "take",
            "text": "覚え書きを預かり、油蔵へ戻る",
            "to": "reason",
            "action": "witness_take"
          }
        ]
      },
      {
        "id": "reason",
        "text": "覚え書きを見たナヴィアは、帳面を隠さなかった。「休みを載せると欠勤分が引かれる。だから消しました。命じたのは私です」。善意で消した印は、エンには怠慢を疑われた跡に見えていた。訂正しても減額の判断は別に残る。",
        "options": [
          {
            "id": "correct",
            "text": "命令者の署名付きで訂正し、減額の扱いを保留して提出する",
            "to": "@corrected",
            "action": "reason_correct"
          },
          {
            "id": "advance",
            "text": "20Gを立て替え、記録を訂正して減額審査を待つ",
            "to": "@advanced",
            "action": "reason_advance"
          },
          {
            "id": "private",
            "text": "公簿の訂正を保留し、覚え書きをエンへ返しに行く",
            "to": "return",
            "action": "reason_private"
          }
        ]
      },
      {
        "id": "return",
        "text": "エンの前へ戻った。公簿を直さずにおくなら、仕事の証拠は本人の手に残す必要がある。ナヴィアが印を消した理由も、彼にはまだ伝わっていない。",
        "options": [
          {
            "id": "explain",
            "text": "理由を伝え、未訂正のままだと説明して覚え書きを返す",
            "to": "@private",
            "action": "return_explain"
          }
        ]
      }
    ],
    "conflict": {
      "request": "油蔵の勤務帳から休み印が一つ消えている。記帳係は、交差路で待つ運搬人にその日のことを聞いてほしいという。",
      "progression": "運搬人の話を聞き、本人が書いた休憩の覚え書きを運ぶ。消した理由を聞いた後、訂正・立替え・私的保管の責任を選ぶ。"
    },
    "choiceContract": {
      "resources": "物語物品は entities、共通の縄・松明・金は cost。戦闘作業は勝利時だけ一括確定する。",
      "residue": "現在の所在・所持・合意・観察・到着を保存し、結末条件を検証する。",
      "interruption": "中断・逃走・敗北中は物語時刻を止める。現場に戻ると最後の場面から再開する。"
    },

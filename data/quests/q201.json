  "scripts": {
    "q201.v11.entry": {
      "storyQuest": "q201",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q201",
          "scene": "entry"
        },
        {
          "op": "say",
          "text": "ナヴィアは帳面の一行だけに乾いた布を当てていた。「数字は合っています。休み印だけ、確かめてきてください」。交差路で待つエンには、まだ給金を渡していない。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "ask",
              "text": "交差路へ行き、エン本人から話を聞く",
              "storyAction": {
                "quest": "q201",
                "action": "entry_ask"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q201",
                  "action": "entry_ask"
                }
              ]
            }
          ]
        }
      ]
    },
    "q201.v11.witness": {
      "storyQuest": "q201",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q201",
          "scene": "witness"
        },
        {
          "op": "say",
          "text": "エンは指に巻いた布をほどいた。「休めと言ったのは向こうです。怠けたことにするなら、せめて自分でそう書いてくれ」。彼は休憩時刻と理由を書いた紙を差し出す。「渡していい。ただ、俺の署名を勝手に足すな」"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "take",
              "text": "覚え書きを預かり、油蔵へ戻る",
              "storyAction": {
                "quest": "q201",
                "action": "witness_take"
              },
              "requirement": "",
              "commands": [
                {
                  "op": "story.journey",
                  "quest": "q201",
                  "action": "witness_take"
                }
              ]
            }
          ]
        }
      ]
    },
    "q201.v11.reason": {
      "storyQuest": "q201",
      "commands": [
        {
          "op": "story.scene",
          "quest": "q201",
          "scene": "reason"
        },
        {
          "op": "say",
          "text": "覚え書きを見たナヴィアは、帳面を隠さなかった。「休みを載せると欠勤分が引かれる。だから消しました。命じたのは私です」。善意で消した印は、エンには怠慢を疑われた跡に見えていた。訂正しても減額の判断は別に残る。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "correct",
              "text": "命令者の署名付きで訂正し、減額の扱いを保留して提出する",

    "locations": {
      "oddland_border": {
        "id": "oddland_border",
        "name": "オッドランド・国境宿場",
        "parent": null,
        "description": "石段を上がると、荷車の車輪が鳴る宿場へ出た。背後の出入窓口から交易回廊を戻れば、地下関所と灯帰りへ帰れる。",
        "background": "location_square",
        "links": []
      },
      "oddland_inn": {
        "id": "oddland_inn",
        "name": "国境宿場の旅籠",
        "parent": "oddland_border",
        "description": "荷を下ろす旅人たちの宿。寝床を借り、同行する仲間を相談できる。",
        "background": "location_tavern",
        "links": [],
        "party": true,
        "services": [
          "inn"
        ]
      },
      "oddland_clinic": {
        "id": "oddland_clinic",
        "name": "国境宿場の施療所",
        "parent": "oddland_border",
        "description": "街道から戻る人のための施療所。所持金がなくても応急手当を受けられる。",
        "background": "location_medical",
        "links": [],
        "services": [
          "clinic"
        ]
      },
      "oddland_supply": {
        "id": "oddland_supply",
        "name": "国境宿場の補給店",
        "parent": "oddland_border",
        "description": "縄と薬を並べた店。店先の公開給油所では携行油を無料で補充できる。預けた油はこの宿場で保管される。",
        "background": "location_shop",
        "links": [],
        "shop": true
      },
      "oddland_skill_shop": {
        "id": "oddland_skill_shop",
        "name": "国境宿場のスキル屋",
        "parent": "oddland_border",
        "description": "技能宝石を使って隊員ごとに教習を受けられる。習得条件は灯帰りの教習所と共通。",
        "background": "location_guild",
        "links": []
      },
      "oddland_board": {
        "id": "oddland_board",
        "name": "国境宿場の共同依頼所",
        "parent": "oddland_border",
        "description": "旅人と住民が立ち寄る共同依頼所。国境の両側から届いた依頼と、宿場の暮らしの相談が掲示されている。受注済みの記録は手帳で確認できる。",
        "background": "location_guild",
        "links": [],
        "quests": true
      }
    },
    "scripts": {
      "e2_oddland_route_sign": {
        "commands": [
          {
            "op": "narrate",
            "text": "道標に「オッドランド方面」と刻まれている。探索隊の名を記帳すれば、乾いた交易回廊へ進める。姉妹の地下通行証とは別の、一般の往来のための登録だ。"
          }
        ]
      }
    }

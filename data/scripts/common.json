{
  "scripts": {
    "prologue": {
      "commands": [
        {
          "op": "say",
          "text": "灯を持って、帰ってくる。\n\n篝火の迷宮の入口に築かれた町、灯帰り。ここでは剣の腕と同じほど、道を記し、話を聞き、仲間を連れて帰る力が買われる。"
        },
        {
          "op": "say",
          "text": "ギルドの机に二百の依頼が積まれている。\n\nまずは「帰らない灯番」を受注し、篝火の迷宮へ。記号のある足元、または正面を調べてください。手掛かりは冒険手帳に残る。"
        }
      ]
    },
    "service.inn": {
      "commands": [
        {
          "op": "rest",
          "cost": 24
        },
        {
          "op": "say",
          "text": "灯を整え、町で一晩を過ごした。手当の結果は隊の状態で確認できる。"
        }
      ]
    },
    "service.clinic": {
      "commands": [
        {
          "op": "rest",
          "cost": 0,
          "ratio": 0.35
        },
        {
          "op": "say",
          "text": "施療所で応急手当を受けた。HP・MPは最低35%まで戻り、毒は治る。所持金がなくても再出発できる。"
        }
      ]
    },
    "service.recruit": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "has_member",
            "actor": "berg"
          },
          "then": [
            {
              "op": "say",
              "text": "ベルグはすでにあなたの隊にいる。"
            }
          ],
          "else": [
            {
              "op": "say",
              "text": "守衛ベルグが机の上の地図を見ている。「五人目が必要なら、次の帰り道を一緒に覚えよう」"
            },
            {
              "op": "choice",
              "options": [
                {
                  "id": "join",
                  "text": "ベルグを隊へ迎える",
                  "commands": [
                    {
                      "op": "party.join",
                      "actor": "berg"
                    },
                    {
                      "op": "say",
                      "text": "ベルグが隊へ加わった。"
                    }
                  ]
                },
                {
                  "id": "later",
                  "text": "今の隊で進む",
                  "commands": []
                }
              ]
            }
          ]
        }
      ]
    },
    "item.potion": {
      "commands": [
        {
          "op": "actor.heal",
          "target": {
            "ref": "local.args.target"
          },
          "amount": 45
        }
      ]
    },
    "item.antidote": {
      "commands": [
        {
          "op": "status.remove",
          "target": {
            "ref": "local.args.target"
          },
          "status": "poison"
        }
      ]
    },
    "item.ration": {
      "commands": [
        {
          "op": "actor.heal",
          "target": "party",
          "amount": 25
        },
        {
          "op": "actor.restore_mp",
          "target": "party",
          "amount": 8
        },
        {
          "op": "say",
          "text": "小さな灯を囲み、糧食を分けた。HP25・MP8回復。"
        }
      ]
    },
    "item.torch": {
      "commands": [
        {
          "op": "call",
          "script": "common.refill_light"
        },
        {
          "op": "map.reveal",
          "radius": 3
        },
        {
          "op": "say",
          "text": "灯油を足した。灯の届く範囲を地図へ書き込む。"
        }
      ]
    },
    "common.refill_light": {
      "commands": [
        {
          "op": "light.refill"
        }
      ]
    },
    "region_1_f1.exit": {
      "commands": [
        {
          "op": "say",
          "text": "灯帰りの町へ戻った。"
        },
        {
          "op": "town.return"
        }
      ]
    },
    "region_1_f1.stairs": {
      "commands": [
        {
          "op": "narrate",
          "text": "荷揚げ場の乾いた階段室が上下層をつないでいる。"
        }
      ]
    },
    "region_1_f2.stairs": {
      "commands": [
        {
          "op": "narrate",
          "text": "荷揚げ場の乾いた階段室が上下層をつないでいる。"
        }
      ]
    },
    "region_1_f1.cache": {
      "commands": [
        {
          "op": "item.give",
          "item": "potion",
          "count": 2
        },
        {
          "op": "item.give",
          "item": "ration",
          "count": 1
        },
        {
          "op": "item.give",
          "item": "key_1",
          "count": 1
        },
        {
          "op": "say",
          "text": "箱には傷薬二つ、糧食一つ、この地域の鍵が残されていた。"
        }
      ]
    },
    "region_1_f1.fountain": {
      "commands": [
        {
          "op": "party.heal_all"
        },
        {
          "op": "say",
          "text": "清い泉で傷を洗った。隊は全回復し、灯も整った。この泉は今回一度だけ使える。"
        }
      ]
    },
    "region_1_f1.trap": {
      "commands": [
        {
          "op": "say",
          "text": "石床が崩れ、細い棘が靴を掠めた。"
        },
        {
          "op": "actor.damage",
          "target": "party",
          "amount": 5
        },
        {
          "op": "status.apply",
          "target": "nio",
          "status": "poison"
        },
        {
          "op": "say",
          "text": "ニオは毒を受けている。解毒薬かセラの術、町の施療所で治せる。"
        }
      ]
    },
    "region_1_f1.door": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "has_item",
            "item": "key_1"
          },
          "then": [
            {
              "op": "flag.set",
              "key": "region_1_f1_door_open",
              "value": true
            },
            {
              "op": "object.state.set",
              "map": "region_1_f1",
              "object": "door",
              "state": "open"
            },
            {
              "op": "gold.change",
              "amount": 45
            },
            {
              "op": "say",
              "text": "鍵を回し、封鎖を解いた。部屋に残された硬貨を回収する。"
            }
          ],
          "else": [
            {
              "op": "say",
              "text": "錠が掛かっている。補給箱に、この地域の鍵がありそうだ。"
            }
          ]
        }
      ]
    },

    "kagaribi.history": {
      "commands": [
        {
          "op": "narrate",
          "text": "篝火の迷宮。この入口を守り、迷宮から帰る人を迎える営みが、灯帰りの町の始まりだった。くらがりが通路の松明を嫌うと知られてから、火を絶やさず篝火を整備する灯番（ともしびばん）の制度が続いている。"
        },
        {
          "op": "narrate",
          "text": "地図の明るい部分は、灯番たちがすでに踏査した巡回区画。奥には、まだ道の記されていない区画が残る。入口の篝火から受け取った松明の火を確かめ、火が弱まる前に補充すること。 巡回図の続きには、油蔵と交差路の詰所、消えた中継篝火、最後の巡回路が記されている。油樽の搬送門は詰所側から、連絡門は広間側から開けられる。"
        }
      ]
    },
    "kagaribi.legend": {
      "commands": [
        {
          "op": "narrate",
          "text": "迷宮の最奥から種火を持ち帰れば、死者を生き返らせられるという。この祭壇の火が伝承の種火なのか、その先に真の最奥があるのか、確かな記録は残っていない。火を採って持ち帰ることはできる。伝承が真実かどうかは、まだわからない。"
        }
      ]
    },
    "kagaribi.restored.crossroads_main": {
      "commands": [
        {
          "op": "flag.set",
          "key": "kagaribi.crossroads_mainSeen",
          "value": true
        },
        {
          "op": "map.reveal",
          "radius": 6
        },
        {
          "op": "narrate",
          "text": "篝火の光が交差路へ伸びた。油樽を運んだ轍が、入口へ戻る搬送門と詰所の戸口を結んでいる。"
        }
      ]
    },
    "kagaribi.restored.relay_main": {
      "commands": [
        {
          "op": "flag.set",
          "key": "kagaribi.relay_mainSeen",
          "value": true
        },
        {
          "op": "map.reveal",
          "radius": 6
        },
        {
          "op": "narrate",
          "text": "高い篝火の炎が広間の梁を照らした。壁沿いに連絡門の鎖が走り、南東には下層への階段が口を開けている。"
        }
      ]
    },
    "kagaribi.restored.last_patrol_main": {
      "commands": [
        {
          "op": "flag.set",
          "key": "kagaribi.last_patrol_mainSeen",
          "value": true
        },
        {
          "op": "map.reveal",
          "radius": 6
        },
        {
          "op": "narrate",
          "text": "火が残った石柱を照らした。崩れた床の向こうに古い台座が見える。現在の巡回記号はここで途切れている。"
        }
      ]
    },
    "kagaribi.oil_manifest": {
      "commands": [
        {
          "op": "narrate",
          "text": "戻らない油樽。詰所の補給記録は昨日で止まっている。倉内の轍は南東の搬出口へ続き、途中に荷車が傾いている。"
        },
        {
          "op": "choice",
          "options": [
            {
              "id": "accept",
              "text": "搬送路を確かめる",
              "commands": [
                {
                  "op": "flag.set",
                  "key": "kagaribi.oilRequested",
                  "value": true
                },
                {
                  "op": "narrate",
                  "text": "油蔵の荷車を調べ、通れる状態へ戻そう。"
                }
              ]
            },
            {
              "id": "leave",
              "text": "探索へ戻る",
              "commands": []
            }
          ]
        }
      ]
    },
    "kagaribi.cart": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.cartCleared"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "車輪は溝を抜け、荷台の油樽も固定されている。搬送門は交差路の詰所側から開けられる。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "荷車の車輪が床板の継ぎ目に落ちている。油樽を支える縄が一本あれば、荷台を傾けずに引き出せそうだ。"
            },
            {
              "op": "choice",
              "options": [
                {
                  "id": "repair",
                  "text": "縄を1本使い、荷車を引き出す",
                  "commands": [
                    {
                      "op": "item.take",
                      "item": "rope",
                      "count": 1
                    },
                    {
                      "op": "flag.set",
                      "key": "kagaribi.oilRequested",
                      "value": true
                    },
                    {
                      "op": "flag.set",
                      "key": "kagaribi.cartCleared",
                      "value": true
                    },
                    {
                      "op": "item.give",
                      "item": "torch",
                      "count": 3
                    },
                    {
                      "op": "gold.change",
                      "amount": 30
                    },
                    {
                      "op": "narrate",
                      "text": "荷車を引き出し、樽を積み直した。運搬人から松明3本と30Gを受け取った。交差路側で搬送門を開ければ、町からの補給が再開する。"
                    }
                  ],
                  "condition": {
                    "op": "has_item",
                    "item": "rope"
                  }
                },
                {
                  "id": "supplies",
                  "text": "資材の調達先を確かめる",
                  "commands": [
                    {
                      "op": "narrate",
                      "text": "油蔵の工具箱に予備の縄がある。使い切った場合は町の旅道具店で購入できる。"
                    }
                  ]
                },
                {
                  "id": "leave",
                  "text": "探索へ戻る",
                  "commands": []
                }
              ]
            }
          ]
        }
      ]
    },
    "kagaribi.tools": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.toolsTaken"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "工具箱には空の縄掛けが残っている。"
            }
          ],
          "else": [
            {
              "op": "flag.set",
              "key": "kagaribi.toolsTaken",
              "value": true
            },
            {
              "op": "item.give",
              "item": "rope",
              "count": 1
            },
            {
              "op": "item.give",
              "item": "torch",
              "count": 2
            },
            {
              "op": "narrate",
              "text": "工具箱から予備の縄1本と松明2本を受け取った。油樽の搬送路を復旧するための備品だ。"
            }
          ]
        }
      ]
    },
    "kagaribi.relief": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.reliefAssigned"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "交代の灯番は、開いた搬送門を通って詰所へ向かった。現地で引き継ぎを確認しよう。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "交代の来ない詰所。交代要員は油蔵で足止めされている。「搬送門が開けば、詰所へ入って当直を休ませられる」"
            },
            {
              "op": "choice",
              "options": [
                {
                  "id": "send",
                  "text": "搬送門の開通を伝え、交代を頼む",
                  "commands": [
                    {
                      "op": "flag.set",
                      "key": "kagaribi.reliefAssigned",
                      "value": true
                    },
                    {
                      "op": "narrate",
                      "text": "交代の灯番は油樽の運搬人とともに出発した。交差路の詰所で、引き継ぎを確認しよう。"
                    }
                  ],
                  "condition": {
                    "op": "eq",
                    "left": {
                      "ref": "flags.kagaribi.cargoGate"
                    },
                    "right": true
                  }
                },
                {
                  "id": "leave",
                  "text": "探索へ戻る",
                  "commands": []
                }
              ]
            }
          ]
        }
      ]
    },
    "kagaribi.cargo_latch": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.cargoGate"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "掛け金は外れている。両側から通行できる。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "門の内側に掛け金がある。先に油蔵の荷車を引き出せば、油樽を通せる。"
            },
            {
              "op": "choice",
              "options": [
                {
                  "id": "open",
                  "text": "掛け金を外して近道を開く",
                  "commands": [
                    {
                      "op": "flag.set",
                      "key": "kagaribi.cargoGate",
                      "value": true
                    },
                    {
                      "op": "audio.se",
                      "asset": "se_door"
                    },
                    {
                      "op": "narrate",
                      "text": "扉が開いた。次の探索でも、この近道を使える。"
                    }
                  ],
                  "condition": {
                    "op": "eq",
                    "left": {
                      "ref": "flags.kagaribi.cartCleared"
                    },
                    "right": true
                  }
                },
                {
                  "id": "leave",
                  "text": "探索へ戻る",
                  "commands": []
                }
              ]
            }
          ]
        }
      ]
    },

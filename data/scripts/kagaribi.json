            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "名札：町で記録を照合し、家族へ返した。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "名札：納骨堂の石棚を調べ、町の灯番詰所で帰還記録と照合する。"
            }
          ]
        }
      ]
    },
    "kagaribi.kiln_hunt": {

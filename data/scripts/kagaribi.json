    "kagaribi.kiln_marks": {
      "commands": [
        {
          "op": "narrate",
          "text": "窯口には赤い火、職人の作業机には青銅の火台がある。職人は「鎮めの火」を携え、獣が集まる作業道を抜けていたらしい。種火は別の台座や携帯松明へ移せる。"
        }
      ]
    },
    "kagaribi.note.crossroads_note": {
      "commands": [
        {
          "op": "narrate",
          "text": "油樽の轍が交差する。消えた中継篝火に燃料を入れれば、詰所と搬送門まで光が届く。"
        }
      ]
    },
    "kagaribi.note.relay_note": {
      "commands": [
        {
          "op": "narrate",
          "text": "灯番が休んでいた広間。中央の中継篝火は消えている。点火すれば、壁沿いの連絡門と下層への階段を確かめられる。"
        }
      ]
    },
    "kagaribi.note.last_note": {
      "commands": [
        {
          "op": "narrate",
          "text": "ここが最後の巡回記号だ。周囲の台座には古い型と新しい型が混在している。中継篝火へ点火し、帰路の目印を残せる。"
        }
      ]
    },
    "kagaribi.note.old_tools": {
      "commands": [
        {
          "op": "narrate",
          "text": "新しい油瓶と古い火鋏が一つの箱にしまわれている。ここを整備した者たちも、さらに奥の台座の用途までは記していない。"
        }
      ]
    },
    "kagaribi.note.inscription": {
      "commands": [
        {
          "op": "narrate",
          "text": "石棚には名札を外した跡が並ぶ。死者を戻す火を求めて潜った者の記録と、帰った日付だけが空欄の帳面が残っている。"
        }
      ]
    },
    "kagaribi.note.route_sign": {
      "commands": [
        {
          "op": "narrate",
          "text": "東へ回れば中継広間。北側の作業戸からは旧炭焼き場へ抜けられる。近道だが、窯の周りには強い魔物が集まる。"
        }
      ]
    },
    "kagaribi.nameplate": {
      "commands": [
        {
          "op": "if",

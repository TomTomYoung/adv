    "kagaribi.post_supply": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "and",
            "args": [
              {
                "op": "eq",
                "left": {
                  "ref": "flags.kagaribi.cargoGate"
                },
                "right": true
              },
              {
                "op": "eq",
                "left": {
                  "ref": "flags.kagaribi.postStaffed"
                },
                "right": true
              }
            ]
          },
          "then": [
            {
              "op": "narrate",
              "text": "搬送路と交代勤務が戻り、詰所に燃料が届いている。松明は1本6G。購入だけでは携帯松明へ補充されない。"
            },
            {
              "op": "choice",
              "options": [
                {
                  "id": "buy",
                  "text": "松明を1本購入する（6G）",
                  "commands": [
                    {
                      "op": "gold.change",
                      "amount": -6
                    },
                    {
                      "op": "item.give",
                      "item": "torch",
                      "count": 1
                    },
                    {
                      "op": "narrate",
                      "text": "松明を1本購入した。旅支度か火の操作から燃料として使える。"
                    }
                  ],
                  "condition": {
                    "op": "and",
                    "args": [
                      {
                        "op": "gte",
                        "left": {
                          "ref": "gold"
                        },
                        "right": 6
                      },
                      {
                        "op": "not",
                        "arg": {
                          "op": "has_item",
                          "item": "torch",
                          "count": 99
                        }
                      }
                    ]
                  },
                  "requirement": "6Gと、松明を入れる空きが必要。"
                },
                {
                  "id": "leave",
                  "text": "詰所へ戻る",
                  "commands": []
                }
              ]
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "補給は止まっている。油蔵の荷車を直して搬送門を開け、油蔵で待つ交代要員へ連絡しよう。詰所で引き継ぎを終えれば、燃料を購入できる。"
            }
          ]
        }
      ]
    },
    "kagaribi.post_watch": {
      "commands": [
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.postStaffed"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "当直を終えた灯番は休んでいる。交代要員が帳面を受け取り、次の巡回を支えている。"
            }
          ],
          "else": [
            {
              "op": "if",
              "condition": {
                "op": "eq",
                "left": {
                  "ref": "flags.kagaribi.reliefAssigned"
                },
                "right": true
              },
              "then": [
                {
                  "op": "flag.set",
                  "key": "kagaribi.postStaffed",
                  "value": true
                },
                {
                  "op": "gold.change",
                  "amount": 20
                },
                {
                  "op": "narrate",
                  "text": "交代要員と勤務簿を照合し、引き継ぎを終えた。疲れた灯番が椅子に腰を下ろす。連絡の礼として20Gを受け取った。詰所の補給窓口が開いた。"
                }
              ],
              "else": [
                {
                  "op": "narrate",
                  "text": "当直の灯番は勤務簿を閉じられずにいる。「次の者は油蔵で足止めされているはずだ。道を通し、こちらへ来るよう伝えてほしい」"
                }
              ]
            }
          ]
        }
      ]
    },
    "kagaribi.records": {
      "commands": [
        {
          "op": "narrate",
          "text": "巡回記録：第一層は油蔵と交差路の詰所。第二層は煤けた回廊の東端から中継広間へ続く。炭焼き場の搬出口は短いが、強い魔物がいる。第三層は最後の巡回路から祭壇へ通じ、納骨堂は脇道にある。"
        },
        {
          "op": "narrate",
          "text": "普通の火はくらがりを遠ざけるが、通常の魔物は現れる。火台のそばでも携帯松明の燃料は減る。残量25歩と8歩の警告を聞いたら、補充と引き返す道を確かめること。"
        },
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "quests.q001.stage"
            },
            "right": "completed"
          },
          "then": [
            {
              "op": "narrate",
              "text": "老人と新人の帰還記録の横に、今回の巡回先が書き足されている。二人の救助に使われた入口区画から、先の道へ仕事がつながっている。"
            }
          ],
          "else": []
        },
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.cargoGate"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "搬送路：荷車と搬送門の復旧を確認した。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "搬送路：油蔵の荷車を直し、交差路側から搬送門を開ける。"
            }
          ]
        },
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.postStaffed"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "勤務交代：引き継ぎが済み、詰所で燃料を購入できる。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "勤務交代：油蔵の交代要員へ連絡し、詰所で当直を確認する。"
            }
          ]
        },
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.huntWon"
            },
            "right": true
          },
          "then": [
            {
              "op": "narrate",
              "text": "炉守り：討伐済み。報酬箱を回収した。"
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "炉守り：炭焼き場の搬出口を開け、赤鉄火台に呼び寄せの火を灯して合図する。"
            }
          ]
        },
        {
          "op": "if",
          "condition": {
            "op": "eq",
            "left": {
              "ref": "flags.kagaribi.memorialDone"

{
  "scripts": {
    "treasure.package.kagaribi_oilstore.tools": {
      "commands": [
        {
          "op": "treasure.collect",
          "map": "kagaribi_oilstore",
          "object": "tools"
        },
        {
          "op": "if",
          "condition": {
            "ref": "local.collected"
          },
          "then": [
            {
              "op": "narrate",
              "text": {
                "format": "{receipt}",
                "values": {
                  "receipt": {
                    "ref": "local.receipt"
                  }
                }
              }
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": {
                "format": "{receipt}",
                "values": {
                  "receipt": {
                    "ref": "local.receipt"
                  }
                }
              }
            }
          ]
        }
      ]
    }
  }
}

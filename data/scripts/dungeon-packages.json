{
  "scripts": {
    "treasure.package.kagaribi_f1.supply_rope": {
      "commands": [
        {
          "op": "treasure.collect",
          "map": "kagaribi_f1",
          "object": "supply_rope"
        },
        {
          "op": "if",
          "condition": {
            "ref": "local.collected"
          },
          "then": [
            {
              "op": "narrate",
              "text": {
                "format": "{receipt}",
                "values": {
                  "receipt": {
                    "ref": "local.receipt"
                  }
                }
              }
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": {
                "format": "{receipt}",
                "values": {
                  "receipt": {
                    "ref": "local.receipt"
                  }
                }
              }
            }
          ]
        }
      ]
    },

    "se_skill_smash": {
      "name": "重打・二段の落とし",
      "use": "最初の低い衝撃に、少し遅れて硬い打音が重なります。 対象技能：強打、水門落とし、金庫の歯、碇打ち、列車突進、肋骨の雨、捨て身の一撃、崩し掌、足払い、構え崩し、殻砕きの突進。 殻の体当たりにも使用します。",
      "file": "assets/audio/se/se_skill_smash.wav",
      "gain": 0.87
    },
    "se_skill_cleave": {
      "name": "薙斬・刃の返し",
      "use": "刃が空気を裂く高い音から、短い低音へ落ちます。 対象技能：引き鋸、硝子の刃、月輪払い、すれ違い斬り、大薙ぎ、槍の横薙ぎ、武器落とし、横列払い、大枝刈り、結晶の強爪、結晶の小爪。",
      "file": "assets/audio/se/se_skill_cleave.wav",
      "gain": 0.87
    },
    "se_skill_thrust": {
      "name": "穿突・鋼の芯",
      "use": "細くせり上がる音を金属の打点と低音で止めます。 対象技能：貫通突き、螺旋突進、活字の針、尾針突き、流星突き、貫通突き、精密穿ち、低位の貫通突進、細い晶片投げ。",
      "file": "assets/audio/se/se_skill_thrust.wav",
      "gain": 0.87
    },
    "se_skill_volley": {
      "name": "連射・三本矢",
      "use": "三本の短い下降音が間を詰めて着弾します。 対象技能：狙いの矢、一斉射撃。",
      "file": "assets/audio/se/se_skill_volley.wav",
      "gain": 0.87
    },
    "se_skill_fire": {
      "name": "火術・火口",
      "use": "高く弾けた火の粉が低い破裂音に変わります。 対象技能：灯火の術、蜜蝋の火、灯火の魔法剣。",
      "file": "assets/audio/se/se_skill_fire.wav",
      "gain": 0.87
    },
    "se_skill_inferno": {
      "name": "爆炎・三連炸裂",
      "use": "高さと間隔の違う三つの爆発が最後の重い破裂へ続きます。 対象技能：炎嵐、爆炎調合、連環火弾。",
      "file": "assets/audio/se/se_skill_inferno.wav",
      "gain": 0.87
    },
    "se_skill_ice": {
      "name": "氷術・晶片",
      "use": "二つの高い結晶音の間を乾いた亀裂が走ります。 対象技能：氷の符。",
      "file": "assets/audio/se/se_skill_ice.wav",
      "gain": 0.87
    },
    "se_skill_glacier": {
      "name": "氷縛・氷柱崩し",
      "use": "三本の氷針が下り、低い破砕音と結晶の響きで閉じます。 対象技能：氷縛、氷結針。",

    "se_skill_grace": {
      "name": "大回復・祈りの和音",
      "use": "低音から四音を積み上げ、最後を二つの高さで支えます。 対象技能：救護の祈り、帰路の祈り。",
      "file": "assets/audio/se/se_skill_grace.wav",
      "gain": 0.87
    },
    "se_skill_cleanse": {
      "name": "浄化・澄み鐘",
      "use": "砂を払う短音に続いて二つの澄んだ鐘が響きます。 対象技能：解毒、清浄の祈り、清水の手当、泥濾し。",
      "file": "assets/audio/se/se_skill_cleanse.wav",
      "gain": 0.87
    },
    "se_skill_ward": {
      "name": "守護・盾鳴り",
      "use": "硬い金属の打点に、据わった五度の響きが続きます。 対象技能：盾の壁、かばう、不動の構え、護甲刻印、聖護の祈り、灯下の庇護、防潮刻印、連結護符、再起の呼吸、鉱脈の補強。",
      "file": "assets/audio/se/se_skill_ward.wav",
      "gain": 0.87
    },
    "se_skill_chant": {
      "name": "鼓舞・三拍の号令",
      "use": "低い拍を添えた歯切れのよい三音で味方を鼓舞します。 対象技能：戦意高揚、気付けの節、勇戦歌、行進歌、奮起の指示、攻勢指揮、調律拍、受け流しの号令。",
      "file": "assets/audio/se/se_skill_chant.wav",
      "gain": 0.87
    },
    "se_skill_focus": {
      "name": "構え・照準の合図",
      "use": "間を空けた二つの電子音が、最後の安定した音に収束します。 対象技能：軽身の構え、魔物解析、地形を読む、弱点注記、姿勢を立て直す、殻を開いて息継ぎ、尾を引く構え（次は強打）、低く身構える（次は突進）。",
      "file": "assets/audio/se/se_skill_focus.wav",
      "gain": 0.87
    },
    "se_skill_drain": {
      "name": "吸収・逆流",
      "use": "高音から低音へ吸い込まれるように三段階で沈みます。 対象技能：墨すすり。",
      "file": "assets/audio/se/se_skill_drain.wav",
      "gain": 0.87
    }
  },

    {
      "id": "kagaribi",
      "title": "灯を受け渡す準備",
      "dungeon": "kagaribi",
      "points": [
        {
          "map": "kagaribi_f1",
          "x": 1,
          "y": 1
        }
      ],
      "trigger": "action",
      "script": "dungeon.scene.kagaribi.v1",
      "condition": {

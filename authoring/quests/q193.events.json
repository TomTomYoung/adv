  "scripts": {
    "dungeon.scene.prayerless_valley.v1": {
      "dungeonScene": "prayerless_valley",
      "commands": [
        {
          "op": "narrate",
          "text": "境界石の内と外で、祈りの届き方を確かめる。治療へ向かう道を作るなら、どこで術を使えるかを確かめておく必要がある。"
        },
        {
          "op": "if",
          "condition": {
            "op": "gte",
            "left": {
              "ref": "location.x"
            },
            "right": 5
          },
          "then": [
            {
              "op": "narrate",
              "text": "境界の内側にいる。回復の祈りと指定された術は使用できず、この区域が遮る祈りや呪いの効果も停止する。病人をどちら側へ運ぶかは、本人の意思と移動の負担を確かめて相談する。"
            },
            {
              "op": "choice",
              "options": [
                {
                  "id": "record",
                  "text": "確認した事実を依頼の手帳へ記す",
                  "condition": {
                    "op": "ne",
                    "left": {
                      "ref": "flags.dungeonNotes.prayerless_valley"
                    },
                    "right": true
                  },
                  "commands": [
                    {
                      "op": "set",
                      "target": "flags.dungeonNotes.prayerless_valley",
                      "value": true
                    },
                    {
                      "op": "narrate",
                      "text": "現地の観察を手帳に記した。"
                    }
                  ]
                },
                {
                  "id": "leave",
                  "text": "探索へ戻る",
                  "commands": []
                }
              ]
            }
          ],
          "else": [
            {
              "op": "narrate",
              "text": "今は境界の外側にいる。境界石を越えた区画で、術の制限がどう変わるかを調べられる。"
            }
          ]
        }
      ]
    }
  }

    "kagaribi.history": {
      "commands": [
        {
          "op": "narrate",
          "text": "篝火の迷宮。この入口を守り、迷宮から帰る人を迎える営みが、灯帰りの町の始まりだった。くらがりが通路の松明を嫌うと知られてから、火を絶やさず篝火を整備する灯番（ともしびばん）の制度が続いている。"
        },
        {
          "op": "narrate",
          "text": "地図の明るい部分は、灯番たちがすでに踏査した巡回区画。奥には、まだ道の記されていない区画が残る。入口の篝火から受け取った松明の火を確かめ、火が弱まる前に補充すること。"
        }
      ]
    },
    "kagaribi.legend": {
      "commands": [
        {
          "op": "narrate",
          "text": "迷宮の最奥から種火を持ち帰れば、死者を生き返らせられるという。この祭壇の火が伝承の種火なのか、その先に真の最奥があるのか、確かな記録は残っていない。火を採って持ち帰ることはできる。伝承が真実かどうかは、まだわからない。"
        }
      ]
    }
  },
  "items": {
    "kagaribi_torch": {
      "id": "kagaribi_torch",
      "name": "携帯松明（篝火の迷宮）",
      "description": "入場時に受け取るくらがり除けの松明。火の効果と残り歩数は探索画面で確認。通常の松明を燃料に補充できます。",
      "type": "dungeon_tool"
    },
    "kagaribi_ember": {
      "id": "kagaribi_ember",
      "name": "種火の火入れ",
      "description": "篝火の迷宮で採った種火を一つ保持します。消えた台座や携帯松明に移せます。火の効果は篝火の迷宮で働きます。",
      "type": "dungeon_tool"
    }
  },
